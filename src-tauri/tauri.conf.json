{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CySec Construct",
  "version": "0.1.1",
  "identifier": "in.cysecguardians.materialmanagementsystem",
  "build": {
    "beforeDevCommand": "npm --prefix ../app run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../app run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CySec Construct",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "materialmanagement"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Business",
    "shortDescription": "Construction contracts, procurement, inventory and contractor settlements",
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "CySec Guardians",
    "longDescription": "CySec Construct is a construction business management desktop application for contracts, procurement, material inventory, contractor work orders, daily material issues, reconciliation and settlements."
  }
}
